# Copy to .env.local. Both must be set for cloud mode; without them the app
# runs entirely in the browser against localStorage and share links are off.
# These are the *anon* (publishable) values and are safe in the client — row
# level security is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
